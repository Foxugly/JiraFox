DJANGO_DEBUG=True
DJANGO_SECRET_KEY=replace-me
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_LOG_LEVEL=INFO

# Email. EMAIL_BACKEND: smtp, console, file, locmem, dummy or a dotted backend path
# (default: console when DJANGO_DEBUG is on, smtp otherwise).
EMAIL_BACKEND=console
EMAIL_HOST=smtp.example.com
# Default port: 465 with SSL, 587 with TLS, 25 otherwise.
EMAIL_PORT=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# STARTTLS (usually 587) or implicit SSL (usually 465), not both.
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=10
# Client certificate, only if the SMTP server asks for one.
EMAIL_SSL_CERTFILE=
EMAIL_SSL_KEYFILE=
# Folder of the file backend (default: sent_emails/).
EMAIL_FILE_PATH=
DEFAULT_FROM_EMAIL=JiraFox <noreply@example.com>
SERVER_EMAIL=
EMAIL_SUBJECT_PREFIX="[JiraFox] "
# Comma-separated addresses notified of server errors when DJANGO_DEBUG is off.
DJANGO_ADMINS=
